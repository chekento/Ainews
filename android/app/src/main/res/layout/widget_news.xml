<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widgetTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="AI NEWS // 3.4" android:textColor="#65F7C4" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" />
        <TextView android:id="@+id/widgetNext" android:layout_width="34dp" android:layout_height="32dp" android:gravity="center" android:text="›" android:contentDescription="Next AI news story" android:textColor="#F5F7FF" android:textSize="22sp" />
        <TextView android:id="@+id/widgetCopilot" android:layout_width="34dp" android:layout_height="32dp" android:gravity="center" android:text="✦" android:contentDescription="Summarize this story with AI News Copilot" android:textColor="#65F7C4" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/widgetRefresh" android:layout_width="34dp" android:layout_height="32dp" android:gravity="center" android:text="↻" android:contentDescription="Refresh AI news widget" android:textColor="#F5F7FF" android:textSize="18sp" />
    </LinearLayout>
    <TextView android:id="@+id/widgetBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="AI ONLY" android:textColor="#65F7C4" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/widgetHeadline" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="3" android:text="Latest AI intelligence" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/widgetMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Source · Desk · LIVE" android:textColor="#9BA8C3" android:textSize="10sp" />
    <TextView android:id="@+id/widgetExtra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:text="AI-only context" android:textColor="#D6DEEF" android:textSize="10sp" />
</LinearLayout>
